{
  "name": "@weibaohui/experts-management",
  "version": "0.4.3",
  "description": "dsh 插件 · 专家管理：管理 ntd 格式的专家与专家团队（plugin.json + Agent MD + 技能集），浏览/安装 50+ 内置专家市场；每个专家注册为「仅用户可调用」的技能，在对话输入框用 /expert-名称 即可以该专家的身份执行任务（宿主确定性注入角色定义与技能清单，不占用模型目录 token）。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "experts",
    "agents",
    "marketplace",
    "ntd",
    "dsh-plugin"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "docs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/index.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build:client && npm run check && npm test"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@weibaohui/dsh-plugin-kit": "^0.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/experts-management.git"
  },
  "homepage": "https://github.com/weibaohui/experts-management#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/experts-management/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
